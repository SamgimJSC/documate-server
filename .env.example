# ──────────────────────────────────────────────────────────────
# 공통
# ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=
HOST=
BASE_URL=
JWT_SECRET=

# ──────────────────────────────────────────────────────────────
# DB
# ──────────────────────────────────────────────────────────────
DB_TYPE=pg
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SYNCHRONIZE=

# ──────────────────────────────────────────────────────────────
# 이메일
# ──────────────────────────────────────────────────────────────
EMAIL=
NODE_MAILER_USER=
NODE_MAILER_PASS=

# ──────────────────────────────────────────────────────────────
# AWS S3 — 파일 업로드 기능(POST /uploads) 사용 시 필수
# AWS IAM 계정에서 발급한 Access Key를 입력하세요.
# 실제 키 값을 이 파일에 직접 작성하지 마세요.
# ──────────────────────────────────────────────────────────────
AWS_REGION=
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CloudFront를 사용하는 경우 도메인을 입력하면 fileUrl이 CloudFront 기준으로 생성됩니다.
# 입력하지 않으면 S3 direct URL로 생성됩니다.
# 예: https://d1234abcd.cloudfront.net
AWS_CLOUDFRONT_URL=
